 "rules": [
  {
   "topic": "Pregnant females",
   "guidance": "Do not give live vaccines during pregnancy. Bring her vaccines up to date before breeding."
  },
  {
   "topic": "Bite or rabies exposure",
   "guidance": "See the vet at once for a rabies booster, even if the dog is vaccinated."
  },
  {
   "topic": "Sick or recovering dogs",
   "guidance": "Wait until the vet confirms the dog is well (for example, after tick fever)."
  },
  {
   "topic": "Deworming: puppies",
   "guidance": "At 2, 4, 6 and 8 weeks; about 5-7 days before each puppy vaccine."
  },
  {
   "topic": "Deworming: 2-6 months",
   "guidance": "Monthly."
  },
  {
   "topic": "Deworming: adults",
   "guidance": "Every 3 months."
  },
  {
   "topic": "Titre testing",
   "guidance": "A blood antibody test at least 4 weeks after the last puppy dose can show whether core boosters are needed."
  }
 ],
