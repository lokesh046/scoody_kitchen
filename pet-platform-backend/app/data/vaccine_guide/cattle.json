 "rules": [
  {
   "topic": "Government campaigns",
   "guidance": "FMD (every 6 months), brucellosis and LSD are given free by the Animal Husbandry Department; record each round on Bharat Pashudhan."
  },
  {
   "topic": "Pregnant cows",
   "guidance": "Ask the vet before any vaccine in late pregnancy; avoid stress and handling close to calving."
  },
  {
   "topic": "New animals",
   "guidance": "Isolate animals bought from markets for 2-3 weeks and vaccinate before mixing with the herd."
  },
  {
   "topic": "Sick animals",
   "guidance": "Do not vaccinate sick or very weak animals; treat first."
  },
  {
   "topic": "Deworming",
   "guidance": "Calves at 10 days, then monthly to 6 months; adults every 3-4 months or as advised. Control ticks to prevent theileriosis."
  },
  {
   "topic": "Ear tag",
   "guidance": "Each animal should carry its 12-digit Pashu Aadhaar ear tag so vaccinations are recorded on Bharat Pashudhan."
  },
  {
   "topic": "IBR",
   "guidance": "A vaccine schedule exists (3 months, booster at 1 month, then every 6 months), but NDDB notes it is not currently produced in India."
  }
 ],
