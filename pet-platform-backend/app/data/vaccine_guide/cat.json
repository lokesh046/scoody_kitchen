 "rules": [
  {
   "topic": "Pregnant queens",
   "guidance": "Do not give live vaccines during pregnancy. Bring her vaccines up to date before breeding."
  },
  {
   "topic": "Bite or rabies exposure",
   "guidance": "See the vet at once for a rabies booster, even if the cat is vaccinated."
  },
  {
   "topic": "Sick or recovering cats",
   "guidance": "Wait until the vet confirms the cat is well."
  },
  {
   "topic": "Injection site",
   "guidance": "Ask your vet to record where each injection was given; check the site for lumps in the weeks after."
  },
  {
   "topic": "Deworming: kittens",
   "guidance": "At 3, 5, 7 and 9 weeks; about 5-7 days before each kitten vaccine."
  },
  {
   "topic": "Deworming: 2-6 months",
   "guidance": "Monthly."
  },
  {
   "topic": "Deworming: adults",
   "guidance": "Every 3 months (indoor cats may need it less often; ask your vet)."
  },
  {
   "topic": "FeLV testing",
   "guidance": "Test for FeLV before starting the FeLV vaccine."
  }
 ],
