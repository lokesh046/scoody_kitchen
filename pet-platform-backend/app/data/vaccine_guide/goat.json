 "about": [
  {
   "label": "Vaccine Schedule",
   "text": "The full table from birth to adult, with age, vaccine, what it protects against and notes. Its status colours follow your animal's records."
  },
  {
   "label": "Timeline",
   "text": "The 8 stages at a glance."
  },
  {
   "label": "Due Date Planner",
   "text": "Uses your kid's date of birth to work out the due date for every dose up to 7 years 4 months. When you record a vaccine as given, its status changes to Done (green). Otherwise it shows Due soon (orange, within 30 days), Overdue (red) or Upcoming. Vaccines only some animals need (endemic areas, crossbred cattle, female calves) show Optional until you record them."
  },
  {
   "label": "Rules & Care",
   "text": "Government campaigns, pregnancy, new animals, sick animals, deworming and the ear tag."
  },
  {
   "label": "Sources",
   "text": "ICAR-IVRI, with links."
  }
 ],
