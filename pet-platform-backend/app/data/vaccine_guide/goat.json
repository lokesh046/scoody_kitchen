 "rules": [
  {
   "topic": "Pregnant does",
   "guidance": "Enterotoxaemia: 2 doses 15 days apart, at least 1 month before kidding. Ask the vet before any live vaccine in late pregnancy."
  },
  {
   "topic": "Government campaigns",
   "guidance": "FMD (every 6 months) and PPR are given free by the Animal Husbandry Department; record each round."
  },
  {
   "topic": "New animals",
   "guidance": "Isolate goats bought from markets for 2-3 weeks and vaccinate before mixing with the herd."
  },
  {
   "topic": "Sick animals",
   "guidance": "Do not vaccinate sick or very weak animals; treat first."
  },
  {
   "topic": "Deworming",
   "guidance": "Kids from about 1 month; then every 3-4 months, and before the monsoon. Rotate drugs as advised by the vet."
  },
  {
   "topic": "Ear tag",
   "guidance": "Each goat should carry its 12-digit Pashu Aadhaar ear tag so vaccinations are recorded on Bharat Pashudhan."
  }
 ],
