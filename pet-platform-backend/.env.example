APP_NAME="Pet Platform API"
DEBUG=True

DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/dbname
JWT_SECRET_KEY=your_jwt_secret_key_here
JWT_ALGORITHM=HS256

ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Image Storage Configuration
IMAGE_STORAGE_PROVIDER=local
UPLOAD_DIR=uploads
BASE_URL=http://127.0.0.1:8000

# Cloud Storage Provider Optional Placeholders
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# EasyPost Shipping Test Configuration
EASYPOST_API_KEY=
EASYPOST_WEBHOOK_SECRET=
EASYPOST_ENABLED=false

# Shipping Provider Configuration ("easypost" or "shiprocket")
SHIPPING_PROVIDER=easypost

# Shiprocket Configuration
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_ENABLED=false
SHIPROCKET_WEBHOOK_TOKEN=
