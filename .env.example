# ==============================================================================
# SCOOBY'S KITCHEN - DOCKER ROOT ENVIRONMENT VARIABLES (TEMPLATE)
# ==============================================================================

# Redis In-Memory Database Security Password
REDIS_PASSWORD=scooby_secure_redis_pass_2026

# Neon Cloud PostgreSQL Connection String
DATABASE_URL=postgresql://pet_user:pet_password@localhost:5432/pet_platform

# --- PgBouncer upstream (Neon) credentials ---------------------------------
# Split out of your real Neon DATABASE_URL
# (postgresql://USER:PASSWORD@HOST:PORT/DBNAME) so pgbouncer can be
# configured via env vars instead of a hand-written ini file. The backend
# replicas connect to pgbouncer using these same USER/PASSWORD/DBNAME, just
# pointed at "pgbouncer:6432" instead of PGBOUNCER_DB_HOST directly — see
# docker-compose.yml.
PGBOUNCER_DB_HOST=ep-your-project-id.region.aws.neon.tech
PGBOUNCER_DB_PORT=5432
PGBOUNCER_DB_USER=pet_user
PGBOUNCER_DB_PASSWORD=your_neon_password_here
PGBOUNCER_DB_NAME=pet_platform
