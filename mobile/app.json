{
  "expo": {
    "name": "Scooby's Kitchen",
    "slug": "scooby-kitchen",
    "scheme": "scoobykitchen",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon-1024.png",
    "ios": {
      "bundleIdentifier": "com.scooby.kitchen",
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Scooby's Kitchen needs camera access to let you take photos of your pet, scan recipes, and be seen during video consultations with the veterinarian.",
        "NSMicrophoneUsageDescription": "Scooby's Kitchen needs microphone access so you can speak during your video consultation with the veterinarian.",
        "NSPhotoLibraryUsageDescription": "Scooby's Kitchen needs access to your photo library so you can upload a profile picture and photos of your pet.",
        "NSLocationWhenInUseUsageDescription": "Scooby's Kitchen uses your location to auto-fill your delivery address at checkout."
      }
    },
    "android": {
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon-1024.png",
        "backgroundColor": "#F9F6F0"
      },
      "package": "com.scooby.kitchen",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyCnKLHt75Dm-UdWQWX-m36vvv00_F-1YfQ"
        }
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "CAMERA",
        "RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO"
      ]
    },
    "plugins": [
      "expo-image",
      "expo-font",
      "expo-sharing",
      "expo-secure-store",
      "@sentry/react-native",
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "image": "./assets/scooby-logo-512.png",
          "resizeMode": "contain",
          "backgroundColor": "#F9F6F0"
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": false,
          "savePhotosPermission": "Scooby's Kitchen needs permission to save your Pet Heritage Passport to your photo library."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#3F5E4D"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "326bc6a2-7b29-4f00-b1c5-6ea53074cd6e"
      }
    },
    "owner": "lokesh_46"
  }
}
