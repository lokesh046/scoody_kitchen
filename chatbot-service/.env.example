# Chatbot Internal Secret for inter-service communication authentication
CHATBOT_INTERNAL_SECRET=your_chatbot_internal_secret_here

# Google Gemini API Key for model inference
GEMINI_API_KEY=your_gemini_api_key_here

# MCP Server endpoint URL
MCP_SERVER_URL=http://localhost:8001/sse

# Shared ML inference service (embeddings + Prompt Guard) — see
# ml-inference-service/. Docker Compose sets this to http://ml-inference:8010;
# this default is for running chatbot-service outside Docker.
ML_INFERENCE_URL=http://localhost:8010

# Redis Connection URL
REDIS_URL=redis://localhost:6379/0

# Pinecone Vector DB credentials for AI Knowledge retrieval
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=scooby-knowledge

# JWT authentication secret for decoding user sessions
JWT_SECRET_KEY=your_jwt_secret_key_here

# MCP Call Token Secret (REQUIRED) - Must match the secret in the pet-platform-mcp-server
MCP_CALL_TOKEN_SECRET=your_mcp_call_token_secret_here

# Whether to call ml-inference-service's Prompt Guard endpoint at all.
# HF_TOKEN, PROMPT_GUARD_MODEL, etc. now live in ml-inference-service/.env —
# this process no longer loads the model itself, only calls the service.
PROMPT_GUARD_ENABLED=true

# Disable third-party telemetry to prevent hangs
DISABLE_LITELLM_TELEMETRY=TRUE

# LangSmith tracing (optional) — turns every chat request into a full trace:
# which agent ran, every tool call, every LLM call, with timing, searchable
# by request. Sign up free at https://smith.langchain.com to get an API key.
# Leave LANGSMITH_TRACING unset/false to run with no tracing (today's default).
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=scooby-kitchen-chatbot

# Reliability tuning — how long to wait on a single Gemini call before giving
# up, and how many times to retry before failing over to the fallback model.
LLM_TIMEOUT_SECONDS=12
LLM_MAX_RETRIES=1

# How long a cached knowledge_agent answer (FAQ-style questions) lives
# before it's forced to refresh, in seconds. Default: 6 hours.
KNOWLEDGE_CACHE_TTL_SECONDS=21600

# Per-user daily token budget — a cost/abuse guardrail separate from the
# per-minute request-count rate limiter. Applies only to logged-in users.
DAILY_TOKEN_LIMIT=50000
