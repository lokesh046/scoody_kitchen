# Inter-service Authentication Secret
MCP_INTERNAL_SECRET=your_mcp_internal_secret_here

# MCP Call Token Secret (REQUIRED) - Must match the secret in the chatbot-service
MCP_CALL_TOKEN_SECRET=your_mcp_call_token_secret_here

# Core Platform Backend API URL
BACKEND_URL=http://localhost:8000

# Redis URL for JTI replay prevention tracking (Optional, defaults to redis://localhost:6379/0)
REDIS_URL=redis://localhost:6379/0

# Port for the SSE server to bind to
PORT=8001
