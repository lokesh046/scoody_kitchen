# Hugging Face token with approved access to the gated Meta Llama Prompt
# Guard repo. Optional — if unset, /prompt-guard always reports
# available=false and chatbot-service falls back to regex-only detection.
HF_TOKEN=your_hugging_face_token_here

PROMPT_GUARD_MODEL=meta-llama/Llama-Prompt-Guard-2-22M
PROMPT_GUARD_ENABLED=true
PROMPT_GUARD_THRESHOLD=0.5
# cpu by default for portability; set to cuda if this service runs on a
# GPU-equipped machine.
PROMPT_GUARD_DEVICE=cpu

PORT=8010
