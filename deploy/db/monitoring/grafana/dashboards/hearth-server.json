{
 "uid": "hearth-server",
 "title": "Hearth & One server and site",
 "tags": [
  "hearth",
  "vps"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "30s",
 "time": {
  "from": "now-6h",
  "to": "now"
 },
 "panels": [
  {
   "id": 1,
   "type": "row",
   "title": "Is everything fine right now?",
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 24,
    "h": 1
   },
   "panels": []
  },
  {
   "id": 2,
   "type": "stat",
   "title": "Website",
   "description": "hearthandone.com answering, checked every 30 s from this server.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 1,
    "w": 3,
    "h": 4
   },
   "targets": [
    {
     "expr": "probe_success{instance=\"https://hearthandone.com/\"}",
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "instant": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "green",
        "value": 1
       }
      ]
     },
     "mappings": [
      {
       "type": "value",
       "options": {
        "1": {
         "text": "UP",
         "color": "green"
        },
        "0": {
         "text": "DOWN",
         "color": "red"
        }
       }
      }
     ],
     "color": {
      "mode": "thresholds"
     }
    },
    "overrides": []
   },
   "options": {
    "colorMode": "background",
    "graphMode": "none",
    "textMode": "value",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    }
   }
  },
  {
