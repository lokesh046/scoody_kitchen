# Pet Vision Service Environment Configuration Template
# Copy this file to .env and fill in the values

# Server configuration
HOST=0.0.0.0
PORT=8003

# Google Gemini API Key for vision model inference & classification
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-latest

# JWT authentication secret - MUST match the JWT_SECRET_KEY in pet-platform-backend
JWT_SECRET_KEY=your_jwt_secret_key_here
JWT_ALGORITHM=HS256

# Redis instance used for the per-user daily scan cap (7 scans / 24h).
# In docker-compose this points at the same redis-limiter container the
# backend's own rate limiter uses (different DB index namespace is not
# required since keys are prefixed "vision_scan_count:").
RATE_LIMIT_REDIS_URL=redis://localhost:6379/2
